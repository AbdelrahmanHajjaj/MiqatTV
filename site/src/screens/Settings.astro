---
// Settings (SettingsActivity): the section sidebar, the open section's rows, and a list
// chooser over the screen. The rows really change this browser's prefs, so Home and the rest follow them.
import Icon from '../components/Icon.astro';
import type { Ctx } from '../lib/ctx';
import { href } from '../lib/site';
import { navHtml, rowsHtml, sectionName, PRAYER } from './settings';
interface Props { ctx: Ctx }
const { ctx } = Astro.props;
const { t, lang } = ctx;
---
<div class="settings" data-settings>
  <aside class="side">
    <div class="head">
      <Icon name="mihrab" size={40} stroke={2} class="mihrab" />
      <h2 class="title display-bold">{t.s('settings')}</h2>
    </div>
    <div data-navs set:html={navHtml(t, PRAYER)} />
  </aside>
  <div class="label caps" data-label>{sectionName(t, PRAYER)}</div>
  <div class="appearance-preview" data-appearance-preview hidden>
    <div class="appearance-home" data-home-plan></div>
    <div class="appearance-caption"><span>{t.s('homeHelp')}</span><h3 data-theme-name></h3><div class="swatches">{['lapis-950','lapis-800','gold-400','plaster-100'].map(c => <i style={`background:var(--color-${c})`}/>)}</div></div>
  </div>
  <div class="rows" data-rows set:html={rowsHtml(ctx, PRAYER)} />
  <div class="saved" data-saved role="status">{t.s('saved')}</div>
  <div class="chooser" data-chooser hidden></div>
  <section class="online-check" data-online hidden role="dialog" aria-modal="true" aria-label={t.s('checkOnline')}>
    <div class="online-heading">
      <button class="ft online-back" data-online-back type="button" aria-label={t.s('back')}><Icon name="back" size={32} /></button>
      <h2 class="display-bold">{t.s('checkOnline')}</h2>
    </div>
    <div class="online-body" data-online-body role="status" aria-live="polite"></div>
    <p class="online-note">{t.s('onlineAdvisory')}</p>
    <button class="ft online-retry" data-online-retry type="button" hidden>{t.s('checkOnline')}</button>
  </section>
  <div class="toast" data-toast-out hidden role="status"></div>
  <a data-home href={href('', lang) + '#tv'} tabindex="-1" hidden>{lang === 'ar' ? 'الرئيسية' : 'Home'}</a>
  <audio data-audio preload="none"></audio>
</div>

<style is:global>
  .settings .online-check { position:absolute; inset:0; z-index:2; background:var(--color-lapis-900); padding:var(--space-safe-block) var(--space-safe-inline); display:flex; flex-direction:column; align-items:flex-start; gap:var(--space-4); }
  .settings .online-check[hidden], .settings .online-check [hidden] { display:none; }
  .settings .online-heading { display:flex; align-items:center; gap:var(--space-6); width:100%; }
  .settings .online-heading h2 { margin:0; font-size:var(--font-size-title); line-height:1.3; }
  .settings .online-back { position:relative; display:grid; place-items:center; flex:none; width:72px; height:72px; border-radius:var(--radius-pill); }
  [dir=rtl] .settings .online-back svg { transform:scaleX(-1); }
  .settings .online-body { width:100%; font-size:var(--font-size-body-l); line-height:1.6; }
  .settings .online-context, .settings .online-note { margin:0; font-size:var(--font-size-caption); line-height:1.6; }
  .settings .online-context { margin-bottom:var(--space-4); }
  .settings .online-check table { width:100%; border-collapse:collapse; }
  .settings .online-check th, .settings .online-check td { padding:12px var(--space-4); text-align:center; border-bottom:1px solid var(--color-lapis-700); }
  .settings .online-check thead { font-size:var(--font-size-label); color:var(--color-mist-400); }
  .settings .online-check tbody th { font-weight:500; }
  .settings .online-retry { position:relative; display:flex; align-items:center; justify-content:center; width:580px; height:72px; font-size:var(--font-size-body); border-radius:var(--radius-cell); }
  .settings .slide { width: var(--layout-settings-carousel-width); height: var(--layout-settings-carousel-height); padding: 0 12px; display: grid; place-items: center; overflow: hidden; white-space: nowrap; font-size: var(--font-size-label); opacity: .65; }
  .settings .slide.home-choice { width:var(--layout-settings-home-arrow-width); }
  .settings .slide.home-choice.on { width:var(--layout-settings-home-choice-width); }
  .settings .slide.on { border-radius: 26px; background: var(--color-lapis-700); color: var(--color-plaster-100); opacity: 1; }

  .settings .appearance-preview { position: absolute; inset-inline-start: var(--layout-settings-content-start); top: var(--layout-settings-rows-top); width: var(--layout-settings-row-width); height: var(--layout-settings-preview-height); display: flex; align-items: center; gap: calc(var(--layout-settings-row-width) - var(--layout-settings-preview-width) - var(--layout-settings-appearance-caption-width)); }
  .settings .appearance-preview[hidden] { display: none; }
  .settings .appearance-home { width: var(--layout-settings-preview-width); height: var(--layout-settings-preview-height); flex: none; background: var(--scene-image); background-color: var(--color-lapis-900); background-size: cover; }
  .settings .appearance-caption { font-size: var(--font-size-label); color: var(--color-mist-400); }
  .settings .appearance-home svg { display: block; width: 100%; height: 100%; }
  .settings .appearance-caption { width: var(--layout-settings-appearance-caption-width); }
  .settings .appearance-caption h3 { font-size: var(--font-size-appearance-title); color: var(--color-plaster-100); margin: 12px 0 24px; }
  .settings .swatches { display: flex; gap: var(--layout-settings-swatch-gap); }
  .settings .swatches i { width: var(--space-6); height: var(--space-6); border-radius: 50%; }

  .settings { position: absolute; inset: 0; }
  .settings .side { position: absolute; inset-block: 0; inset-inline-start: 0; width: var(--layout-settings-sidebar-width); background: var(--color-lapis-950); }
  .settings .head { position: absolute; inset-inline-start: 96px; top: 56px; display: flex; align-items: center; gap: var(--space-3); }
  .settings .mihrab { color: var(--color-gold-400); }
  .settings .title { font-size: var(--font-size-title); color: var(--color-plaster-100); line-height: 1.2; }
  .settings .nav {
    inset-inline-start: 96px; width: 424px; height: 76px; align-items: center; padding: 0 var(--space-4);
    border-radius: var(--radius-cell); font-size: var(--font-size-body); color: var(--color-mist-400); --rest-fill: transparent;
  }
  .settings .nav.open { --rest-fill: var(--surface-fill, var(--color-lapis-800)); --rest-border: var(--color-gold-400); --rest-border-width: 2px; color: var(--color-plaster-100); }
  .settings .nav:focus, .tv:not(:focus-within) .settings .nav[data-focus-start] { color: var(--focus-text); }
  .settings .label { position: absolute; inset-inline-start: var(--layout-settings-content-start); top: 56px; font-size: var(--font-size-label); color: var(--color-mist-400); }
  .settings .hints { inset-inline-start: var(--layout-settings-content-start); top: 976px; }
  .settings .saved {
    position: absolute; inset-inline-end: 96px; top: 976px; font-size: var(--font-size-label); font-weight: 500; color: var(--color-gold-400);
    opacity: 0; transition: opacity var(--motion-overlay-fade) linear; pointer-events: none;
  }
  .settings .saved.on { opacity: 1; }

  .settings .rows.scrolling { position:absolute; inset-inline-start:calc(var(--layout-settings-content-start) - var(--layout-settings-scroll-padding)); top:calc(var(--layout-settings-appearance-top) - var(--layout-settings-scroll-padding)); width:calc(var(--layout-settings-row-width) + 2 * var(--layout-settings-scroll-padding)); height:calc(var(--layout-settings-appearance-rows-height) - var(--focus-ring-offset) - var(--focus-ring-width)); overflow-y:auto; overflow-x:hidden; padding:var(--layout-settings-scroll-padding); display:flex; flex-direction:column; gap:var(--layout-settings-row-gap); }
  .settings .appearance-group { font-family:var(--font-family-ui);font-weight:500;flex:none; margin:16px 12px 0; font-size:var(--font-size-label); color:var(--color-mist-400); }
  .settings .rows.scrolling .srow { position:relative; inset-inline-start:auto; top:auto !important; flex:none; }
  .tv[data-large-ui='true'] .settings .side { width:calc(var(--large-side-start) + 464px); }
  .tv[data-large-ui='true'] .settings .head { inset-inline-start:var(--large-side-start); top:var(--large-top); }
  .tv[data-large-ui='true'] .settings .nav { inset-inline-start:var(--large-side-start); top:calc(var(--large-rows-top) + var(--nav-index) * 74px) !important; height:64px; }
  .tv[data-large-ui='true'] .settings .label { inset-inline-start:var(--large-content-start); top:var(--large-top); max-width:var(--large-content-width); }
  .tv[data-large-ui='true'] .settings .rows.scrolling {
    inset-inline-start:calc(var(--large-content-start) - var(--layout-settings-scroll-padding));
    top:calc(var(--large-rows-top) - var(--layout-settings-scroll-padding));
    width:calc(var(--large-content-width) + 2 * var(--layout-settings-scroll-padding));
    height:calc(1080px - var(--large-top) - var(--large-rows-top) + var(--layout-settings-scroll-padding));
  }
  .tv[data-large-ui='true'] .settings .rows.appearance { top:calc(var(--large-rows-top) + 224px - var(--layout-settings-scroll-padding)); height:calc(1080px - var(--large-top) - var(--large-rows-top) - 224px + var(--layout-settings-scroll-padding)); }
  .tv[data-large-ui='true'] .settings .rows .srow { width:100%; height:auto; min-height:var(--layout-settings-row-height); flex-direction:column; align-items:flex-start; padding:12px var(--layout-settings-row-padding); gap:12px; }
  .tv[data-large-ui='true'] .settings .words { width:100%; }
  .tv[data-large-ui='true'] .settings .rh { white-space:normal; overflow:visible; }
  .tv[data-large-ui='true'] .settings .offset-time { position:static; transform:none; width:auto; }
  .tv[data-large-ui='true'] .settings .appearance-preview { inset-inline-start:var(--large-content-start); top:var(--large-rows-top); width:var(--large-content-width); height:200px; gap:24px; }
  .tv[data-large-ui='true'] .settings .appearance-home { width:45%; height:auto; aspect-ratio:16/9; }
  .tv[data-large-ui='true'] .settings .appearance-caption { width:calc(55% - 24px); }
  .tv[data-large-ui='true'] .settings .appearance-caption h3 { margin:8px 0 12px; }
  .tv[data-large-ui='true'] .settings .swatches { gap:var(--space-2); }
  .tv[data-large-ui='true'] .settings .hints { display:none; }
  .tv[data-large-ui='true'] .settings .ch-list { max-height:calc(1080px / var(--ui-size) - 240px); }
  .tv[data-large-ui='true'] .settings .online-body { min-height:0; overflow-y:auto; }
  .tv[data-large-ui='true'] .settings .online-heading, .tv[data-large-ui='true'] .settings .online-note, .tv[data-large-ui='true'] .settings .online-retry { flex-shrink:0; }
  /* Rows: label and help at the start, the control at the end. */
  .settings .srow {
    inset-inline-start: var(--layout-settings-content-start); width: var(--layout-settings-row-width); height: var(--layout-settings-row-height); padding: 0 var(--layout-settings-row-padding); align-items: center; justify-content: space-between;
    gap: var(--space-4); border-radius: var(--radius-row); text-align: start;
  }
  .settings .srow:focus { transform: scale(var(--focus-scale-settings-row)); }
  .settings .words { display: flex; flex-direction: column; min-width: 0; }
  .settings .rl { font-size: var(--font-size-body); font-weight: 500; line-height: 1.3; }
  .settings .rh { font-size: var(--font-size-caption); opacity: 0.75; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.35; }
  .settings .offset-time { position:absolute; left:50%; transform:translateX(-50%); width:var(--layout-settings-offset-time-width); text-align:center; font-size:var(--font-size-body-l); font-weight:500; white-space:nowrap; }

  .settings .ctl { display: flex; align-items: center; flex: none; }
  /* Editing: a lapis ring around the control on the gold row. */
  .settings .srow.editing .ctl { padding: 6px; border-radius: var(--radius-pill); box-shadow: inset 0 0 0 3px var(--color-lapis-900); }
  .settings .val { font-size: 24px; margin-inline-end: var(--space-2); }
  .settings .chev { flex: none; }
  [dir='rtl'] .settings .chev { transform: scaleX(-1); }

  .settings .track { display: flex; padding: 6px; border-radius: var(--radius-pill); background: var(--color-lapis-900); }
  .settings .srow:focus .track { background: var(--color-seg-track-focused); }
  .settings .seg { height: var(--layout-settings-carousel-height); padding: 0 var(--space-4); display: flex; align-items: center; border-radius: var(--radius-pill); font-size: var(--font-size-label); color: var(--color-mist-400); }
  .settings .seg.on { background: var(--color-plaster-100); color: var(--color-lapis-900); }
  .settings .srow:focus .seg { color: var(--color-lapis-900); }
  .settings .srow:focus .seg.on { background: var(--color-lapis-900); color: var(--color-plaster-100); box-shadow: inset 0 0 0 3px var(--color-plaster-100); }

  .settings .stepb { width: var(--space-6); height: var(--space-6); border-radius: var(--radius-pill); background: var(--color-lapis-700); color: var(--color-plaster-100); display: grid; place-items: center; font-size: var(--font-size-body); }
  .settings .stepv { min-width: 150px; margin: 0 18px; text-align: center; font-size: var(--font-size-body); }

  .settings .switch { width: var(--layout-settings-row-height); height: var(--space-6); border-radius: var(--radius-pill); background: var(--color-lapis-700); display: flex; align-items: center; padding: 0 6px; }
  .settings .switch i { width: 36px; height: 36px; border-radius: 50%; background: var(--color-mist-400); }
  .settings .switch.on { background: var(--color-gold-400); justify-content: flex-end; }
  .settings .switch.on i { background: var(--color-lapis-900); }
  .settings .srow:focus .switch.on { background: var(--color-lapis-900); }
  .settings .srow:focus .switch.on i { background: var(--color-gold-400); }

  /* The list chooser over the screen. */
  .settings .chooser { position: absolute; inset: 0; background: var(--color-scrim-menu); display: grid; place-items: center; }
  .settings .chooser[hidden] { display: none; }
  .settings .ch-card { width: 900px; padding: 40px var(--space-6) 32px; background: var(--color-lapis-800); border-radius: var(--radius-panel); box-shadow: inset 0 0 0 2px var(--color-gold-400-60); }
  .settings .ch-title { font-size: var(--font-size-display-s); color: var(--color-gold-400); line-height: 1.2; }
  .settings .ch-list { position: relative; max-height: calc(8 * 74px + 20px); overflow: hidden; padding: 10px; margin: 0 -10px; display: flex; flex-direction: column; gap: 6px; }
  .settings .ch-item {
    position: relative; flex: none; height: 68px; width: 100%; align-items: center; padding: 0 var(--space-4);
    border-radius: var(--radius-cell); font-size: var(--font-size-body); font-weight: 400; text-align: start; --rest-fill: transparent;
  }
  .settings .ch-item.chosen { --rest-fill: var(--surface-fill, var(--color-lapis-800)); color: var(--color-gold-400); font-weight: 500; }
  .settings .ch-item:focus { transform: none; color: var(--focus-text); }

  .settings .toast { position: absolute; inset-inline-end: var(--space-safe-inline); bottom: var(--space-safe-block); max-width: var(--layout-toast-width); padding: 24px 32px; border-radius: var(--radius-panel); background: var(--color-plaster-100); color: var(--color-lapis-900); font-size: var(--font-size-body); }
  .settings .toast[hidden] { display: none; }
</style>

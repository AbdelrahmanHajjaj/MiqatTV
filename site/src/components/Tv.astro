---
// The 1920×1080 TV stage with the star lattice ground (Ui.starLattice), scaled into a 16:9 frame by the inline script below
// (inline so the TV still fits when a cached page outlives its script bundle after a deploy).
import tokens from '../../../shared/design/mihrab/tokens.json';
import tileDesign from '../../../shared/design/background-tile.json';
interface Props { mode?: string; screen: string; ground?: 'lattice' | 'black' }
const tile = parseFloat(tokens.background['tile-size'].$value);
const { mode, screen, ground = 'lattice' } = Astro.props;
---
<div class="tv-frame">
  <div class="tv" data-mode={mode} data-screen={screen} data-ground={ground}>
    <svg class="ambient-ridge" aria-hidden="true" width="1920" height="1080" viewBox="0 0 480 270">
      <path d="M0 234 C100 208 175 255 278 226 C374 196 418 225 480 204 L480 270 L0 270 Z" />
    </svg>
    {ground === 'lattice' && (
      <svg class="lattice" aria-hidden="true" width="1920" height="1080">
        <defs>
          <pattern id="miqat-tile" width={tile} height={tile} patternUnits="userSpaceOnUse">
            <g fill="none" stroke="var(--color-pattern-line)" stroke-width={tokens.background['tile-stroke'].$value}>
              <path d={tileDesign.path} transform={`scale(${tile/tileDesign.width} ${tile/tileDesign.height})`} vector-effect="non-scaling-stroke" />
            </g>
          </pattern>
        </defs>
        <rect width="1920" height="1080" fill="url(#miqat-tile)" />
      </svg>
    )}
    <div class="tv-ui"><slot /></div>
  </div>
</div>
<script is:inline>
  (() => {
    const frame = document.currentScript.previousElementSibling, stage = frame.firstElementChild;
    const fit = () => stage.style.setProperty('--k', String(frame.clientWidth / 1920));
    new ResizeObserver(fit).observe(frame);
    fit();
  })();
</script>

<style>
  .lattice { position: absolute; inset: 0; pointer-events: none; }
  .tv[data-ground='black'] { background: var(--color-screensaver-ground); }
</style>

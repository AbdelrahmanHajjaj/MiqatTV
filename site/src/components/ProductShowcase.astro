---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PhoneDemo from './PhoneDemo.astro';
import type { Lang } from '../lib/text';
import { LG_ASSET, REPO, RELEASE_TAG } from '../lib/site';
import widgetStrip from '../../../companion/android/src/main/res/drawable-nodpi/widget_preview_strip.png';
import widgetStripAr from '../../../companion/android/src/main/res/drawable-ar-nodpi/widget_preview_strip.png';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const fullSize = ar ? 'افتح اللقطة بالحجم الكامل' : 'Open full-size screenshot';
const sources = import.meta.glob('../../../docs/screenshots/*.png', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const shot = (name: string) => {
  const source = sources[`../../../docs/screenshots/${name}-${lang}.png`];
  if (!source) throw new Error(`Missing product screenshot: ${name}-${lang}`);
  return source;
};
const L = ar ? {
  eyebrow: 'MIQAT · ميقات', title: ['مواقيت الصلاة', 'على هاتفك وتلفازك'],
  intro: 'تابع مواقيت صلاتك واستمع إلى الأذان على هاتف أندرويد وتلفاز البيت، حتى دون إنترنت.',
  getCta: 'نزّل ميقات', phoneCta: 'عرض الهاتف', tvCta: 'عرض التلفاز',
  gallery: 'لقطات الشاشة', companionCta: 'جرّب التحكم بالتلفاز',
  phone: 'الهاتف', companion: 'التحكم بالتلفاز', android: 'أندرويد TV', lg: 'LG webOS',
  phoneTitle: 'ميقات على هاتف أندرويد', phoneIntro: 'مواقيت الصلاة والأذان، والقبلة، والتقويم الهجري، وإذاعة القرآن.',
  phoneGuide: 'دليل الهاتف',
  screens: [
    ['phone-home', 'الصلاة القادمة ومواقيت يومك', 'اعرف موعد الصلاة القادمة والوقت المتبقي لها، وشاهد مواقيت بقية اليوم.'],
    ['phone-calendar', 'التقويم الهجري', 'شاهد رقم كل يوم من رمضان، وأيام العيدين والحج، ومواقيت الصلاة في أي يوم تختاره.'],
    ['phone-fasting', 'تذكيرات الصيام', 'اضبط تذكيرات اليوم السابق للصيام والسحور والإفطار لرمضان وأيام التطوّع التي تختارها، ومنها الاثنين والخميس.'],
    ['phone-radio', 'إذاعة القرآن', 'استمع إلى الإذاعة حتى عند إطفاء الشاشة. يعرض مشغّل أندرويد ألوان ميقات وخلفيته.'],
    ['phone-prayer', 'تنبيهات تناسب يومك', 'استمع إلى الأذان، أو اختر نغمة قصيرة أو تنبيهًا صامتًا لكل صلاة، مع تذكيرات في الأيام التي تختارها.'],
    ['phone-voices', 'استمع إلى أذانك المفضّل', 'اختر من ١٣ صوتًا للأذان أو أضف تسجيلًا تحبّه من جهازك.'],
    ['phone-qibla', 'اعرف اتجاه القبلة', 'حدّد اتجاه مكة بالبوصلة والخريطة، في البيت وأثناء السفر.'],
    ['phone-widgets', 'المواقيت على الشاشة الرئيسية', 'شاهد الصلاة القادمة من شاشة هاتفك الرئيسية قبل فتح التطبيق.'],
    ['phone-style', 'ألوان وخلفيات على ذوقك', 'اختر من الثيمات الملوّنة والمناظر الطبيعية والزخارف ما يناسبك.'],
    ['phone-location', 'مواقيتك أينما ذهبت', 'تابع مواقيت مدينتك، مع تحديث اختياري للموقع أثناء السفر.'],
  ],
  widgets: 'الصلاة القادمة أمامك', widgetCopy: 'شاهد الصلاة القادمة وجدول اليوم والتاريخ الهجري على الشاشة الرئيسية، بحجم يناسب ترتيب شاشتك.', widgetAlt: 'ويدجت ميقات يعرض مواقيت الصلاة على الشاشة الرئيسية',
  companionTitle: 'تحكّم بميقات على التلفاز من هاتفك', companionIntro: 'ثبّت ميقات على التلفاز، وغيّر مظهره وشغّل إذاعة القرآن من تطبيق الهاتف.',
  companionGuide: 'الإعداد والربط',
  companionScreens: [
    ['companion-tvs', 'أجهزة تلفازك في تطبيق واحد', 'ثبّت ميقات وأضف أجهزة التلفاز التي تستخدمها في البيت.'],
    ['companion-remote', 'الإذاعة والمداخل من هاتفك', 'شغّل إذاعة القرآن، أو بدّل مدخل التلفاز، أو عُد إلى شاشة ميقات.'],
    ['companion-appearance', 'مظهر تختاره للتلفاز', 'اختر ألوان التلفاز وخلفياته واضبط إعدادات ميقات من هاتفك.'],
  ],
  tvTitle: 'مواقيت الصلاة لكل أهل البيت', tvIntro: 'شاهد موعد الصلاة القادمة من مكانك في الغرفة، واستمع إلى الأذان وإذاعة القرآن على التلفاز.',
  androidTitle: 'Android TV / Google TV', androidCopy: 'اجمع تطبيقات التلفاز المفضّلة ومواقيت الصلاة في شاشة رئيسية واحدة، مع الأذان والتذكير وإذاعة القرآن.',
  lgTitle: 'LG webOS', lgCopy: 'تابع مدخل HDMI إلى جانب مواقيت الصلاة، واستمع إلى الأذان وإذاعة القرآن على تلفاز LG.',
  getTitle: 'نزّل ميقات لجهازك',
  iosAvailability: 'قريبًا على iOS',
  guide: 'دليل التثبيت', releases: 'ملاحظات الإصدار وكل التنزيلات',
  downloads: [
    ['miqat-phone.apk', 'هاتف أندرويد', 'مواقيت الصلاة، وتذكيرات الصيام، وإذاعة القرآن، والتحكّم بالتلفاز.', 'تنزيل لأندرويد', 'docs/PHONE.md'],
    ['miqat.apk', 'Android TV / Google TV', 'مواقيت الصلاة وتطبيقاتك المفضّلة على شاشة التلفاز الرئيسية.', 'تنزيل لأندرويد TV', 'docs/ANDROID-SETUP.md'],
    [LG_ASSET, 'LG webOS', 'مواقيت الصلاة والأذان وإذاعة القرآن على تلفاز LG.', 'تنزيل لتلفاز LG', 'docs/WEBOS.md'],
  ],
} : {
  eyebrow: 'MIQAT · ميقات', title: ['Prayer times for', 'your phone and TV'],
  intro: 'Keep up with daily prayers on your Android phone and TV, with offline prayer times and Adhan.',
  getCta: 'Download Miqat', phoneCta: 'Phone demo', tvCta: 'TV demo',
  gallery: 'Screenshots', companionCta: 'Try the phone remote',
  phone: 'Phone', companion: 'TV controls', android: 'Android TV', lg: 'LG webOS',
  phoneTitle: 'Miqat on Android phones', phoneIntro: 'Prayer times, Adhan, Qibla, the Hijri calendar and Quran radio.',
  phoneGuide: 'Phone guide',
  screens: [
    ['phone-home', 'Your next prayer and the day ahead', 'See when the next prayer begins, how long remains and the rest of your day’s prayer times.'],
    ['phone-calendar', 'Hijri calendar', 'See each numbered day of Ramadan, the Eid holidays and Hajj dates. Pick a date to view its prayer times.'],
    ['phone-fasting', 'Fasting reminders', 'Set day-before, suhoor and iftar reminders for Ramadan and voluntary fasts, including Mondays and Thursdays.'],
    ['phone-radio', 'Quran radio', 'Listen with the screen off. Android’s media player uses your Miqat theme and background.'],
    ['phone-prayer', 'Alerts for your routine', 'Hear the Adhan, use a short tone or keep a prayer silent. Set reminders for the days you need them.'],
    ['phone-voices', 'Hear your favourite Adhan', 'Choose from 13 voices or add a recording you love from your own device.'],
    ['phone-qibla', 'Find the Qibla', 'Find the direction of Makkah with a compass and map, at home or while travelling.'],
    ['phone-widgets', 'Prayer times on your home screen', 'Check the next prayer from your phone’s home screen, before opening the app.'],
    ['phone-style', 'Colours and backgrounds', 'Personalise Miqat with colours, illustrated landscapes and geometric patterns.'],
    ['phone-location', 'Prayer times wherever you go', 'Get prayer times for your city, with optional location updates when you travel.'],
  ],
  widgets: 'Keep the next prayer in view', widgetCopy: 'See the next prayer, daily timetable and Hijri date on your home screen, in a size that suits your layout.', widgetAlt: 'Miqat prayer-times widget for the Android home screen',
  companionTitle: 'Control Miqat on TV from your phone', companionIntro: 'Install Miqat on your TV, choose its look and control Quran radio from the phone app.',
  companionGuide: 'Setup and pairing',
  companionScreens: [
    ['companion-tvs', 'Your TVs in one app', 'Install Miqat and add the TVs you use at home.'],
    ['companion-remote', 'Radio and TV controls', 'Start Quran radio, switch TV inputs or return to Miqat from your phone.'],
    ['companion-appearance', 'Personalise your TV', 'Choose your TV’s colours and backgrounds from your phone.'],
  ],
  tvTitle: 'Prayer times for the whole household', tvIntro: 'See the next prayer across the room, hear the Adhan and listen to Quran radio on your TV.',
  androidTitle: 'Android TV / Google TV', androidCopy: 'Bring your favourite TV apps and prayer times together on the Home screen, with Adhan, reminders and Quran radio.',
  lgTitle: 'LG webOS', lgCopy: 'Watch HDMI alongside prayer times, and listen to Adhan and Quran radio on your LG TV.',
  getTitle: 'Download Miqat for your device',
  iosAvailability: 'iOS coming soon',
  guide: 'Installation guide', releases: 'Release notes & all downloads',
  downloads: [
    ['miqat-phone.apk', 'Android phone', 'Prayer times, fasting reminders, Quran radio and TV controls.', 'Download for Android', 'docs/PHONE.md'],
    ['miqat.apk', 'Android TV / Google TV', 'Prayer times and your favourite apps on the TV Home screen.', 'Download for Android TV', 'docs/ANDROID-SETUP.md'],
    [LG_ASSET, 'LG webOS', 'Prayer times, Adhan and Quran radio on your LG TV.', 'Download for LG', 'docs/WEBOS.md'],
  ],
};
---
<section class="product-hero" aria-labelledby="product-title">
  <div class="hero-copy">
    <p class="kicker">{L.eyebrow}</p>
    <h1 id="product-title">{L.title.map(line => <span>{line}</span>)}</h1>
    <p class="hero-intro">{L.intro}</p>
    <div class="actions"><a class="primary" href="#get-miqat">{L.getCta}</a><a href="#phone-demo">{L.phoneCta}</a><a href="#tv">{L.tvCta}</a></div>
  </div>
  <figure class="hero-images">
    <div class="hero-tv"><Image src={shot('android-home')} alt={L.androidTitle} widths={[640, 960, 1440]} sizes="(max-width: 800px) 90vw, 54vw" loading="eager" format="webp" /></div>
    <Image class="hero-phone" src={shot('phone-home')} alt={ar ? 'ميقات على هاتف أندرويد' : 'Miqat on an Android phone'} widths={[240, 420, 640]} sizes="(max-width: 800px) 24vw, 15vw" loading="eager" format="webp" />
  </figure>
</section>
<nav class="product-rail" aria-label={ar ? 'تطبيقات ميقات' : 'Miqat apps'}>
  <a href="#phone">{L.phone}</a><a href="#companion">{L.companion}</a><a href="#android-tv">{L.android}</a><a href="#lg-webos">{L.lg}</a>
</nav>
<section id="phone" class="product-section" aria-labelledby="phone-title">
  <div class="section-heading"><div><p class="kicker">{L.phone} · Android 8+</p><h2 id="phone-title">{L.phoneTitle}</h2></div><a href={`${REPO}/blob/main/docs/PHONE.md`}>{L.phoneGuide}</a></div>
  <p class="section-intro">{L.phoneIntro}</p>
  <PhoneDemo lang={lang} />
  <details class="product-gallery" data-gallery><summary>{L.gallery}</summary>
  <div class="phone-gallery">
    {L.screens.map(([name, title, description]) => <figure>
      <a class="phone-image" href={shot(name).src} target="_blank" rel="noreferrer" aria-label={`${title}: ${fullSize}`}><Image src={shot(name)} alt={title} widths={[320, 480, 720]} sizes="(max-width: 560px) 84vw, (max-width: 1000px) 40vw, 21vw" format="webp" /></a>
      <figcaption><h3>{title}</h3><p>{description}</p></figcaption>
    </figure>)}
  </div>
  </details>
  <div class="widget-feature"><div><h3>{L.widgets}</h3><p>{L.widgetCopy}</p></div><Image src={ar ? widgetStripAr : widgetStrip} alt={L.widgetAlt} widths={[480, 800, 1200]} sizes="(max-width: 800px) 85vw, 48vw" format="webp" /></div>
</section>
<section id="companion" class="product-section companion-section" aria-labelledby="companion-title">
  <div class="section-heading"><div><p class="kicker">{L.companion}</p><h2 id="companion-title">{L.companionTitle}</h2></div><a href={`${REPO}/blob/main/companion/README.md`}>{L.companionGuide}</a></div>
  <p class="section-intro">{L.companionIntro}</p>
  <div class="actions"><a href="#phone-demo" data-open-phone-tvs>{L.companionCta}</a></div>
  <details class="product-gallery" data-gallery><summary>{L.gallery}</summary>
  <div class="phone-gallery companion-gallery">
    {L.companionScreens.map(([name, title, description]) => <figure>
      <a class="phone-image" href={shot(name).src} target="_blank" rel="noreferrer" aria-label={`${title}: ${fullSize}`}><Image src={shot(name)} alt={title} widths={[320, 480, 720]} sizes="(max-width: 560px) 84vw, (max-width: 1000px) 40vw, 24vw" format="webp" /></a>
      <figcaption><h3>{title}</h3><p>{description}</p></figcaption>
    </figure>)}
  </div>
  </details>
</section>
<section class="product-section" aria-labelledby="tvs-title">
  <p class="kicker">{L.android} · {L.lg}</p><h2 id="tvs-title">{L.tvTitle}</h2><p class="section-intro">{L.tvIntro}</p>
  <div class="actions tv-demo-link"><a class="primary" href="#tv">{L.tvCta}</a></div>
  <div class="tv-gallery">
    {[
      ['android-tv', 'android-home', L.androidTitle, L.androidCopy],
      ['lg-webos', 'lg-home', L.lgTitle, L.lgCopy],
    ].map(([id, image, title, copy]) => <figure id={id}>
      <figcaption><h3>{title}</h3><p>{copy}</p></figcaption>
      <details class="product-gallery" data-gallery><summary>{L.gallery}</summary>
        <a class:list={['tv-image', { native: id === 'android-tv' }]} href={shot(image).src} target="_blank" rel="noreferrer" aria-label={`${title}: ${fullSize}`}><Image src={shot(image)} alt={title} widths={[640, 960, 1440]} sizes="(max-width: 800px) 90vw, 45vw" format="webp" /></a>
      </details>
    </figure>)}
  </div>
</section>
<section id="get-miqat" class="product-section get-section" aria-labelledby="get-title">
  <h2 id="get-title">{L.getTitle}</h2>
  <div class="download-grid">{L.downloads.map(([file, title, description, label, guide]) => <article class="download-card">
    <h3>{title}</h3><p>{description}</p>
    <div class="actions"><a class="primary" href={`${REPO}/releases/download/${RELEASE_TAG}/${file}`}>{label}</a><a href={`${REPO}/blob/main/${guide}`}>{L.guide}</a></div>
  </article>)}</div>
  <p class="section-intro">{L.iosAvailability}</p>
  <a class="release-link" href={`${REPO}/releases/tag/${RELEASE_TAG}`}>{L.releases}</a>
</section>
<style>
  section, figure[id] { scroll-margin-top:2rem; }
  .product-hero { display:grid; grid-template-columns:1fr 1.15fr; gap:clamp(28px,4vw,64px); align-items:center; padding:clamp(44px,6vw,100px) 0 48px; }
  .kicker { color:var(--color-gold-400); font-size:.875rem; line-height:1.7; letter-spacing:.07em; margin:0 0 18px; }
  h1 { font-size:clamp(2.75rem,4.7vw,5rem); line-height:1.12; text-wrap:balance; }
  h1 span { display:block; }
  .hero-intro { font-size:1.125rem; color:var(--color-mist-400); line-height:1.85; max-width:35rem; margin:26px 0; }
  .actions { display:flex; align-items:center; gap:20px; flex-wrap:wrap; font-size:1rem; }
  .actions a { padding:14px 0; text-underline-offset:5px; }
  .actions .primary { padding:14px 22px; background:var(--color-gold-400); color:var(--color-lapis-950); border-radius:10px; text-decoration:none; font-weight:600; }
  .hero-images { position:relative; width:100%; min-width:0; margin:0; padding:10% 9% 12% 0; }
  .hero-images :global(img) { display:block; height:auto; box-shadow:0 20px 60px #0005; }
  .hero-tv { position:relative; aspect-ratio:1920/1020; width:100%; overflow:hidden; border:1px solid var(--color-line-soft); border-radius:12px; box-shadow:0 20px 60px #0005; }
  .hero-tv :global(img) { position:absolute; inset:0; width:100%; }
  .hero-images :global(.hero-phone) { position:absolute; width:29%; inset-inline-end:0; top:0; border:5px solid #102b30; border-radius:24px; }
  .product-rail { display:flex; justify-content:space-between; flex-wrap:wrap; gap:16px 32px; border-block:1px solid var(--color-line-soft); padding:22px 0; font-size:1rem; }
  .product-rail a { text-decoration:none; }
  .product-section { padding:clamp(52px,7vw,100px) 0; border-bottom:1px solid var(--color-line-soft); }
  .section-heading { display:flex; align-items:end; justify-content:space-between; gap:28px; }
  .section-heading > a { flex:none; font-size:1rem; padding-bottom:8px; text-underline-offset:5px; }
  h2 { font-size:clamp(2rem,3.2vw,3.5rem); line-height:1.25; text-wrap:balance; }
  h3 { font-size:1.4rem; line-height:1.45; }
  .section-intro { color:var(--color-mist-400); font-size:1.125rem; line-height:1.85; max-width:56rem; margin:24px 0 40px; }
  .product-gallery { margin-top:20px; }
  .product-gallery summary { width:fit-content; color:var(--color-gold-400); cursor:pointer; }
  .product-gallery[open] summary { margin-bottom:24px; }
  .phone-gallery { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:44px 26px; }
  figure { margin:0; min-width:0; }
  .phone-image { display:block; padding:10px; background:linear-gradient(150deg,#1d474c88,#082b3088); border:1px solid var(--color-line-soft); border-radius:24px; cursor:zoom-in; }
  .phone-image :global(img) { display:block; width:100%; height:auto; border-radius:15px; }
  figcaption h3 { margin:20px 0 10px; }
  figcaption p, .widget-feature p, .download-card p { font-size:1rem; line-height:1.85; color:var(--color-mist-400); margin:0; }
  .widget-feature { display:grid; grid-template-columns:1fr 1.3fr; align-items:center; gap:40px; margin-top:52px; padding:32px; background:#123b4088; border-radius:18px; }
  .widget-feature h3 { margin-bottom:12px; }
  .widget-feature :global(img) { width:100%; height:auto; }
  .companion-gallery { grid-template-columns:repeat(3,minmax(0,1fr)); max-width:1020px; margin-inline:auto; gap:40px; }
  .tv-gallery { display:grid; grid-template-columns:1fr 1fr; gap:32px; }
  .tv-image { display:block; position:relative; aspect-ratio:16/9; overflow:hidden; border-radius:12px; border:1px solid var(--color-line-soft); }
  .tv-image.native { aspect-ratio:1920/1020; }
  .tv-image :global(img) { position:absolute; inset:0; width:100%; height:auto; display:block; }
  .tv-demo-link { margin-bottom:24px; }
  .download-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; margin-top:32px; }
  .download-card { display:flex; flex-direction:column; gap:20px; padding:28px; background:#123b4088; border:1px solid var(--color-line-soft); border-radius:16px; }
  .download-card .actions { margin-top:auto; padding-top:12px; align-items:start; flex-direction:column; gap:8px; }
  .release-link { display:inline-block; margin-top:28px; font-size:1rem; text-underline-offset:5px; }
  @media(max-width:1100px) { .phone-gallery { grid-template-columns:repeat(3,minmax(0,1fr)); } .companion-gallery { gap:24px; } }
  @media(max-width:800px) { .product-hero { grid-template-columns:1fr; gap:12px; } .hero-images { max-width:680px; margin:auto; } .phone-gallery { grid-template-columns:repeat(2,minmax(0,1fr)); } .widget-feature,.download-grid { grid-template-columns:1fr; gap:26px; } .tv-gallery { grid-template-columns:1fr; gap:40px; } .section-heading { align-items:start; flex-direction:column; gap:18px; } }
  @media(max-width:560px) { .phone-gallery { grid-template-columns:1fr; max-width:360px; margin-inline:auto; gap:38px; } .product-rail { justify-content:start; gap:16px 24px; } .widget-feature { padding:24px 18px; } .hero-images :global(.hero-phone) { border-width:3px; border-radius:14px; } }
  :global([dir='rtl']) .kicker { letter-spacing:0; }
  :global([dir='rtl']) .hero-images { padding-inline:0 9%; }
  a:focus-visible { outline:2px solid var(--color-gold-400); outline-offset:5px; }
</style>

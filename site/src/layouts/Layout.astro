---
import '../styles/base.css';
import ProductShowcase from '../components/ProductShowcase.astro';
import { INSTALL, PAGES, REPO, BASE, href, type Page } from '../lib/site';
import type { Lang } from '../lib/text';
import sacred from '../../../shared/data/sacred-text.json';

interface Props { lang: Lang; page: Page }
const { lang, page } = Astro.props;
const ar = lang === 'ar';
const home = page.slug === '';
const other: Lang = ar ? 'en' : 'ar';
const abs = (path: string) => new URL(path, Astro.site!).href;
const canonical = abs(href(page.slug, lang));
const ogImage = abs(`${BASE}branding/product-${lang}.png`);
const name = ar ? 'ميقات' : 'Miqat';
const L = ar ? {
  phone: 'الهاتف', companion: 'رفيق التلفاز', tvs: 'التلفاز', install: 'احصل على ميقات',
  source: 'الكود على GitHub', screens: 'شاشات التلفاز', lang: 'English', skip: 'انتقل إلى المحتوى',
  tvLabel: 'معاينة ميقات التفاعلية للتلفاز', preview: 'جرّب واجهة التلفاز',
  intro: 'معاينة تفاعلية بواجهات جهاز محاكاة. تعمل المواقيت والإعدادات في متصفحك؛ لا تتصل بتلفاز ولا تشغّل الأذان.',
  keys: 'الأسهم للتنقل · Enter موافق · Esc رجوع',
  foot: 'مفتوح المصدر، بلا حسابات أو إعلانات أو تحليلات. المواقيت تُحسب دون إنترنت. الإذاعة ومقارنة المواقيت وخرائط القبلة الاختيارية تتصل عند طلبك. ربط التلفاز على شبكة البيت؛ إعدادات المعاينة تبقى في هذا المتصفح.',
} : {
  phone: 'Phone', companion: 'TV companion', tvs: 'TV apps', install: 'Get Miqat',
  source: 'Source on GitHub', screens: 'TV screens', lang: 'العربية', skip: 'Skip to content',
  tvLabel: 'Interactive Miqat TV preview', preview: 'Try the TV interface',
  intro: 'An interactive preview with simulated device APIs. Times and settings work in this browser; it does not connect to a TV or play Adhan.',
  keys: 'Arrows move · Enter is OK · Esc is Back',
  foot: 'Open source, without accounts, ads or analytics. Prayer calculation works offline. Optional radio, prayer comparison and Qibla maps connect when requested. TV pairing stays on your home network; preview settings stay in this browser.',
};
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Miqat', alternateName: 'ميقات',
  applicationCategory: 'LifestyleApplication', operatingSystem: ['Android', 'Android TV', 'LG webOS'],
  description: page.description[lang], inLanguage: ['ar', 'en'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://opensource.org/licenses/MIT', codeRepository: REPO, screenshot: ogImage, url: abs(href('', lang)),
};
---
<!doctype html>
<html lang={lang} dir={ar ? 'rtl' : 'ltr'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{page.title[lang]}</title>
  <meta name="description" content={page.description[lang]} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={lang} href={canonical} />
  <link rel="alternate" hreflang={other} href={abs(href(page.slug, other))} />
  <link rel="alternate" hreflang="x-default" href={abs(href(page.slug, 'ar'))} />
  <link rel="sitemap" href={BASE + 'sitemap-index.xml'} />
  <link rel="icon" href={BASE + 'branding/icon.png'} type="image/png" />
  <meta name="theme-color" content="#033B44" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={name} />
  <meta property="og:locale" content={ar ? 'ar_EG' : 'en_GB'} />
  <meta property="og:locale:alternate" content={ar ? 'en_GB' : 'ar_EG'} />
  <meta property="og:title" content={page.title[lang]} />
  <meta property="og:description" content={page.description[lang]} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="skip" href="#main">{L.skip}</a>
  <header class="top">
    <a class="brand" href={href('', lang)}><img src={BASE + 'branding/icon.png'} width="48" height="48" alt="" /><span>{name}</span></a>
    <nav class="top-links" aria-label={ar ? 'روابط ميقات' : 'Miqat links'}>
      <a href={href('', lang) + '#phone'}>{L.phone}</a>
      <a href={href('', lang) + '#companion'}>{L.companion}</a>
      <a href={href('', lang) + '#android-tv'}>{L.tvs}</a>
      <a href={href(page.slug, other)} hreflang={other} lang={other} data-preview-language>{L.lang}</a>
      <a class="cta" href={href('', lang) + '#get-miqat'}>{L.install}</a>
    </nav>
  </header>
  <main id="main">
    {home ? <ProductShowcase lang={lang} /> : <section class="screen-heading"><p class="eyebrow">{ar ? 'معاينة التلفاز' : 'TV PREVIEW'}</p><h1>{page.title[lang]}</h1><p>{page.description[lang]}</p></section>}
    <section id="tv" class="tv-wrap" aria-label={L.tvLabel}>
      <div class="preview-heading"><h2>{L.preview}</h2><span data-preview-title aria-live="polite" aria-atomic="true">{page.nav[lang]}</span></div>
      <p class="preview-intro">{L.intro}</p>
      <nav class="screens" aria-label={L.screens}><ul>{PAGES.map(p => <li><a href={href(p.slug, lang)} data-preview-nav aria-controls="preview-host" aria-current={p.slug === page.slug ? 'page' : undefined}>{p.nav[lang]}</a></li>)}</ul></nav>
      <slot />
      <p class="keys">{L.keys}</p>
    </section>
    <article class="about" data-preview-copy><p class="lede">{page.description[lang]}</p>{page.body[lang].map(para => <p>{para}</p>)}</article>
  </main>
  <footer class="foot">
    <p class="sacred" lang="ar" dir="rtl">{sacred.prayerVerse.join(' ')}</p>
    <div class="foot-details"><p>{L.foot}</p><p><a href={`${REPO}/releases`}>{ar ? 'الإصدارات العامة' : 'Public releases'}</a> · <a href={INSTALL}>{ar ? 'البناء والتثبيت' : 'Build and install'}</a> · <a href={REPO}>{L.source}</a></p></div>
  </footer>
</body>
</html>
<script>
  import '../scripts/tv';
  import '../scripts/navigation';
</script>
<style>
  body { --gutter:clamp(20px,4vw,72px); background:radial-gradient(ellipse at 90% 0%,color-mix(in srgb,var(--color-gold-400) 7%,transparent),transparent 32%),var(--color-lapis-950); }
  .top { display:flex; align-items:center; justify-content:space-between; gap:24px; padding:24px var(--gutter); max-width:1600px; margin:auto; }
  .brand { display:flex; align-items:center; gap:12px; color:var(--color-plaster-100); text-decoration:none; font-family:var(--display); font-weight:var(--display-weight); font-size:2rem; }
  .brand img { object-fit:contain; }
  .top-links { display:flex; align-items:center; justify-content:flex-end; gap:clamp(16px,2.2vw,32px); flex-wrap:wrap; font-size:.9375rem; }
  .top-links a { text-decoration:none; }
  .cta { border:1px solid var(--color-line-soft); border-radius:8px; padding:12px 18px; color:var(--color-plaster-100); }
  .cta:hover { border-color:var(--color-gold-400); }
  a:focus-visible { outline:2px solid var(--color-gold-400); outline-offset:5px; }
  .skip { position:absolute; z-index:10; inset-inline-start:20px; top:-100px; padding:12px 20px; background:var(--color-gold-400); color:var(--color-lapis-950); }
  .skip:focus { top:12px; }
  main { max-width:1600px; padding:0 var(--gutter); margin:auto; }
  .screen-heading { padding:44px 0; max-width:1000px; }
  .eyebrow { font-size:.875rem; color:var(--color-gold-400); margin:0 0 20px; }
  h1 { font-size:clamp(2rem,4vw,4rem); line-height:1.2; text-wrap:balance; }
  .screen-heading > p:last-child,.preview-intro { font-size:1rem; color:var(--color-mist-400); line-height:1.85; max-width:900px; }
  .tv-wrap { padding-top:56px; scroll-margin-top:24px; }
  .preview-heading { display:flex; align-items:baseline; justify-content:space-between; gap:20px; margin-bottom:18px; }
  .preview-heading h2 { font-size:clamp(1.75rem,3vw,2.75rem); }
  .preview-heading > span { font-size:.875rem; color:var(--color-mist-400); }
  .preview-intro { margin-bottom:24px; }
  .screens { margin-bottom:20px; }
  .screens ul { display:flex; flex-wrap:wrap; gap:8px; list-style:none; padding:0; margin:0; }
  .screens a { display:block; padding:10px 16px; border:1px solid transparent; border-radius:6px; color:var(--color-mist-400); text-decoration:none; font-size:.875rem; }
  .screens a:hover { color:var(--color-plaster-100); border-color:var(--color-line-soft); }
  .screens a[aria-current] { color:var(--color-gold-400); border-color:var(--color-line-soft); background:color-mix(in srgb,var(--color-gold-400) 5%,transparent); }
  .tv-wrap :global(.tv-frame) { border-radius:14px; outline-color:color-mix(in srgb,var(--color-gold-400) 22%,transparent); box-shadow:0 24px 80px #0003; }
  .keys { font-size:.875rem; color:var(--color-mist-400); text-align:end; margin:14px 0 0; }
  .about { max-width:900px; margin:48px 0 64px; color:var(--color-mist-400); font-size:1rem; line-height:1.9; }
  .about :global(.lede) { color:var(--color-plaster-100); font-size:1.25rem; line-height:1.7; }
  .foot { border-top:1px solid var(--color-line-soft); padding:40px var(--gutter); max-width:1600px; margin:auto; }
  .foot .sacred { font-size:1.6rem; text-align:center; margin:0 0 30px; }
  .foot-details { display:flex; justify-content:space-between; gap:40px; color:var(--color-mist-400); font-size:.875rem; line-height:1.9; }
  .foot-details p { margin:0; max-width:760px; }
  .foot-details p:last-child { flex:none; }
  @media(max-width:800px) { .top { flex-wrap:wrap; gap:18px; } .top-links { justify-content:start; flex-basis:100%; gap:14px 22px; } .brand { font-size:1.75rem; } .brand img { width:42px; height:42px; } .cta { padding:9px 12px; } .foot-details { flex-direction:column; gap:20px; } .screens ul { flex-wrap:nowrap; overflow-x:auto; padding:4px; } .screens a { white-space:nowrap; } }
  @media(hover:none) { .keys { display:none; } }
</style>

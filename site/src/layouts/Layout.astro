---
// A bilingual product page around the interactive TV preview.
import '../styles/base.css';
import { INSTALL, PAGES, REPO, href, type Page } from '../lib/site';
import type { Lang } from '../lib/text';
import sacred from '../../../shared/data/sacred-text.json';

interface Props { lang: Lang; page: Page }
const { lang, page } = Astro.props;
const ar = lang === 'ar';
const other: Lang = ar ? 'en' : 'ar';
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const canonical = abs(href(page.slug, lang));
const ogImage = abs(import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'branding/splash.png');
const name = ar ? 'ميقات' : 'Miqat';
const L = ar
  ? { install: 'البناء والتثبيت', source: 'الكود على GitHub', screens: 'الشاشات', lang: 'English', skip: 'انتقل إلى المعاينة',
      title: 'مواقيت الصلاة على تلفازك.', intro: 'مواقيت الصلاة دون إنترنت، والأذان في وقته، وإذاعة القرآن الكريم. بالعربية والإنجليزية، وتحكم يناسب ريموت التلفاز.',
      tvLabel: 'معاينة ميقات التفاعلية', preview: 'جرّب ميقات', keys: 'الأسهم للتنقل · Enter موافق · Esc رجوع',
      features: [
        ['المواقيت كما تناسبك', 'اختر مدينتك وطريقة الحساب ومذهب العصر، واضبط التعديلات لكل صلاة. تُحسب المواقيت على جهازك دون إنترنت.'],
        ['ميقات بطريقتك', 'ثيمات جاهزة وخلفيات ميقات الأصلية، مع تخصيص التخطيط وحجم الواجهة وشفافية المحراب.'],
        ['للتلفاز في بيتك', 'شاشة رئيسية لأندرويد TV، وتطبيق مستقل لـ LG webOS يعرض HDMI. هذه المعاينة تحاكي وظائف التلفاز.'],
      ],
      foot: 'مفتوح المصدر. بلا حسابات أو إعلانات أو تحليلات. إعدادات المعاينة تبقى في متصفحك. تتصل الإذاعة ومقارنة المواقيت بالإنترنت عند طلبك فقط.' }
  : { install: 'Build and install', source: 'Source on GitHub', screens: 'Screens', lang: 'العربية', skip: 'Skip to the preview',
      title: 'Prayer times, on your TV.', intro: 'Offline prayer times, adhan when it is time, and Quran radio. Arabic and English, with controls built for a TV remote.',
      tvLabel: 'Interactive Miqat preview', preview: 'Try Miqat', keys: 'Arrows move · Enter is OK · Esc is Back',
      features: [
        ['Your prayer day', 'Choose your city, calculation method and Asr school, with adjustments for each prayer. Times are calculated on your device, offline.'],
        ['Make it yours', 'Preset themes and original Miqat artwork, with controls for layout, interface size and mihrab opacity.'],
        ['For the TV at home', 'A Home launcher for Android TV and a separate LG webOS app with HDMI. This preview simulates TV integration.'],
      ],
      foot: 'Open source. No accounts, ads or analytics. Preview settings stay in this browser. Radio and online prayer comparison connect when requested.' };
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Miqat',
  alternateName: 'ميقات',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: ['Android TV', 'LG webOS'],
  description: page.description[lang],
  inLanguage: ['ar', 'en'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://opensource.org/licenses/MIT',
  codeRepository: REPO,
  screenshot: ogImage,
  url: abs(href('', lang)),
};
---
<!doctype html>
<html lang={lang} dir={ar ? 'rtl' : 'ltr'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{page.title[lang]}</title>
  <meta name="description" content={page.description[lang]} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={lang} href={canonical} />
  <link rel="alternate" hreflang={other} href={abs(href(page.slug, other))} />
  <link rel="alternate" hreflang="x-default" href={abs(href(page.slug, 'ar'))} />
  <link rel="sitemap" href={import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'sitemap-index.xml'} />
  <link rel="icon" href={import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'branding/icon.png'} type="image/png" />
  <meta name="theme-color" content="#033B44" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={name} />
  <meta property="og:locale" content={ar ? 'ar_EG' : 'en_GB'} />
  <meta property="og:locale:alternate" content={ar ? 'en_GB' : 'ar_EG'} />
  <meta property="og:title" content={page.title[lang]} />
  <meta property="og:description" content={page.description[lang]} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1920" />
  <meta property="og:image:height" content="1080" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="visually-hidden" href="#tv">{L.skip}</a>
  <header class="top">
    <a class="brand" href={href('', lang)} data-preview-nav>
      <img src={import.meta.env.BASE_URL + 'branding/icon.png'} width="52" height="52" alt="" />
      <span>{name}</span>
    </a>
    <nav class="top-links" aria-label={ar ? 'روابط ميقات' : 'Miqat links'}>
      <a href={href(page.slug, other)} hreflang={other} lang={other} data-preview-language>{L.lang}</a>
      <a href={REPO}>GitHub</a>
      <a class="cta" href={INSTALL}>{L.install}<span aria-hidden="true"> ↗</span></a>
    </nav>
  </header>

  <main>
    <section class="hero" aria-labelledby="product-title">
      <div>
        <p class="eyebrow" dir="ltr">MIQAT · ميقات</p>
        <h1 id="product-title">{L.title}</h1>
      </div>
      <div class="hero-note">
        <p>{L.intro}</p>
        <p class="platforms" dir="ltr"><span>Android TV / Google TV</span><span>LG webOS</span></p>
      </div>
    </section>

    <section id="tv" class="tv-wrap" aria-label={L.tvLabel}>
      <div class="preview-heading">
        <h2>{L.preview}</h2>
        <span data-preview-title aria-live="polite" aria-atomic="true">{page.nav[lang]}</span>
      </div>
      <nav class="screens" aria-label={L.screens}>
        <ul>
          {PAGES.map(p => <li><a href={href(p.slug, lang)} data-preview-nav aria-controls="preview-host" aria-current={p.slug === page.slug ? 'page' : undefined}>{p.nav[lang]}</a></li>)}
        </ul>
      </nav>
      <slot />
      <p class="keys">{L.keys}</p>
    </section>

    <article class="about" data-preview-copy>
      <p class="lede">{page.description[lang]}</p>
      {page.body[lang].map(para => <p>{para}</p>)}
    </article>
    <section class="features" aria-label={ar ? 'عن ميقات' : 'About Miqat'}>
      {L.features.map(([title, description]) => <div><h2>{title}</h2><p>{description}</p></div>)}
    </section>
  </main>

  <footer class="foot">
    <p class="sacred" lang="ar" dir="rtl">{sacred.prayerVerse.join(' ')}</p>
    <div class="foot-details"><p>{L.foot}</p><p><a href={INSTALL}>{L.install}</a> · <a href={REPO}>{L.source}</a></p></div>
  </footer>
</body>
</html>

<script>
  import '../scripts/tv';
  import '../scripts/navigation';
</script>

<style>
  body { --gutter:clamp(20px,4vw,72px); background:radial-gradient(ellipse at 90% 0%, color-mix(in srgb,var(--color-gold-400) 6%,transparent),transparent 48%),var(--color-lapis-950); }
  .top { display:flex; align-items:center; justify-content:space-between; gap:24px; padding:24px var(--gutter); max-width:1600px; margin:auto; }
  .brand { display:flex; align-items:center; gap:12px; color:var(--color-plaster-100); text-decoration:none; font-family:var(--display); font-weight:var(--display-weight); font-size:34px; }
  .brand img { object-fit:contain; }
  .top-links { display:flex; align-items:center; justify-content:flex-end; gap:clamp(16px,3vw,36px); flex-wrap:wrap; font-size:14px; }
  .top-links a { text-decoration:none; }
  .cta { border:1px solid var(--color-line-soft); border-radius:6px; color:var(--color-plaster-100); padding:12px 18px; }
  .cta:hover { border-color:var(--color-gold-400); }
  a:focus-visible { outline:2px solid var(--color-gold-400); outline-offset:5px; }
  main { max-width:1600px; padding:0 var(--gutter); margin:auto; }
  .hero { display:grid; grid-template-columns:1.2fr 1fr; align-items:end; gap:64px; padding:clamp(28px,5vw,76px) 0 clamp(36px,5vw,72px); }
  .eyebrow { color:var(--color-gold-400); letter-spacing:.14em; font-size:12px; margin:0 0 20px; text-align:start; }
  h1 { font-size:clamp(38px,4.8vw,78px); max-width:750px; color:var(--color-plaster-100); line-height:1.13; text-wrap:balance; }
  .hero-note > p:first-child { font-size:clamp(16px,1.3vw,20px); line-height:1.8; color:var(--color-mist-400); margin:0; max-width:560px; }
  .platforms { display:flex; flex-wrap:wrap; gap:10px 20px; font-size:11px; letter-spacing:.04em; margin:24px 0 0; color:var(--color-gold-400); }
  :global([dir='rtl']) .platforms { justify-content:flex-end; }
  .preview-heading { display:flex; align-items:baseline; justify-content:space-between; gap:20px; margin-bottom:20px; }
  .preview-heading h2 { font-size:26px; }
  .preview-heading > span { font-size:13px; color:var(--color-mist-400); }
  .screens { margin-bottom:20px; }
  .screens ul { display:flex; flex-wrap:wrap; gap:8px; list-style:none; padding:0; margin:0; }
  .screens a { display:block; padding:10px 16px; border:1px solid transparent; border-radius:6px; color:var(--color-mist-400); text-decoration:none; font-size:13px; transition:color .15s,border-color .15s; }
  .screens a:hover { color:var(--color-plaster-100); border-color:var(--color-line-soft); }
  .screens a[aria-current] { color:var(--color-gold-400); border-color:var(--color-line-soft); background:color-mix(in srgb,var(--color-gold-400) 5%,transparent); }
  .tv-wrap :global(.tv-frame) { border-radius:14px; outline-color:color-mix(in srgb,var(--color-gold-400) 22%,transparent); box-shadow:0 24px 80px #0003; }
  .keys { font-size:12px; color:var(--color-mist-400); text-align:end; margin:14px 0 0; }
  .about { max-width:900px; margin:clamp(36px,5vw,72px) 0; color:var(--color-mist-400); font-size:15px; line-height:1.9; }
  .about :global(.lede) { color:var(--color-plaster-100); font-size:clamp(19px,1.5vw,24px); line-height:1.7; }
  .features { display:grid; grid-template-columns:repeat(3,1fr); gap:48px; margin:0 0 72px; border-top:1px solid var(--color-line-soft); padding-top:36px; }
  .features h2 { font-size:25px; color:var(--color-plaster-100); margin-bottom:16px; }
  .features p { color:var(--color-mist-400); font-size:14px; line-height:1.9; margin:0; }
  .foot { border-top:1px solid var(--color-line-soft); padding:40px var(--gutter); max-width:1600px; margin:auto; }
  .foot .sacred { font-size:25px; text-align:center; margin:0 0 30px; }
  .foot-details { display:flex; align-items:start; justify-content:space-between; gap:40px; color:var(--color-mist-400); font-size:12px; line-height:1.9; }
  .foot-details p { margin:0; max-width:760px; }
  .foot-details p:last-child { flex:none; }
  @media(max-width:800px) { .hero { grid-template-columns:1fr; gap:24px; } .features { grid-template-columns:1fr; gap:28px; } .foot-details { flex-direction:column; gap:20px; } .top { gap:16px; } .brand { font-size:28px; } .brand img { width:42px; height:42px; } .top-links { gap:16px; font-size:12px; } .cta { padding:10px 12px; } .screens ul { flex-wrap:nowrap; overflow-x:auto; padding:4px; } .screens a { white-space:nowrap; } }
  @media(hover:none) { .keys { display:none; } }
  @media(prefers-reduced-motion:reduce) { .screens a { transition:none; } }
</style>

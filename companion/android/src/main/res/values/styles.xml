<resources>
    <style name="Theme.Companion" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/alexandria_regular</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/companion_gold_400</item>
        <item name="android:windowBackground">@color/companion_lapis_900</item>
    </style>
    <style name="MiqatWidgetText">
        <item name="android:fontFamily">@font/alexandria_regular</item>
        <item name="android:textColor">@color/companion_plaster_100</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="MiqatWidgetValue" parent="MiqatWidgetText">
        <item name="android:fontFamily">@font/alexandria_semibold</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="MiqatWidgetMuted" parent="MiqatWidgetText">
        <item name="android:textColor">@color/companion_mist_400</item>
    </style>
    <dimen name="widget_corner_rounded">24dp</dimen>
    <dimen name="widget_corner_soft">12dp</dimen>
    <dimen name="widget_corner_square">0dp</dimen>
    <style name="MiqatWidgetHero" parent="MiqatWidgetText"><item name="android:fontFamily">@font/marcellus_regular</item><item name="android:textSize">28sp</item></style>
    <style name="MiqatWidgetHeroArabic" parent="MiqatWidgetHero"><item name="android:fontFamily">@font/amiri_bold</item></style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:clipToOutline="true">
<LinearLayout
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="@font/alexandria_regular" android:textSize="12sp" android:text="@string/app_name" android:maxLines="1" />
    <LinearLayout android:id="@+id/widget_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
        <TextView android:id="@+id/widget_next_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/alexandria_regular" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_next_time" android:layout_width="match_parent" android:layout_height="56dp" android:fontFamily="@font/alexandria_semibold" android:textSize="34sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="40sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_prayers" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    <LinearLayout android:id="@+id/widget_strip" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
    <TextView android:id="@+id/widget_times" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/alexandria_regular" android:textSize="14sp" />
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/alexandria_regular" android:textSize="11sp" android:maxLines="1" />
</LinearLayout>
</FrameLayout>

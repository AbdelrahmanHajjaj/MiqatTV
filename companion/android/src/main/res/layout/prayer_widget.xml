<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews needs its own background when hosted by the launcher. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="Overdraw"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:padding="16dp" android:background="@color/companion_lapis_900">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
        android:textColor="@color/companion_gold_400" android:text="@string/app_name" android:maxLines="2" />
    <TextView android:id="@+id/widget_times" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:textSize="15sp"
        android:textColor="@color/companion_plaster_100" android:gravity="center_vertical"
        android:layout_marginTop="8dp" android:layout_marginBottom="8dp" />
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/companion_plaster_100" />
</LinearLayout>

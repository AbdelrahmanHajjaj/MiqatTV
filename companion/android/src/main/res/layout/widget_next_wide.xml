<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
<ImageView android:id="@+id/widget_next_highlight" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_highlight" android:scaleType="fitXY" android:importantForAccessibility="no" android:contentDescription="@null"/>
<LinearLayout android:id="@+id/widget_next_wide_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
<ImageView android:id="@+id/widget_next_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:importantForAccessibility="no" android:contentDescription="@null"/>
<TextView android:id="@+id/widget_next_label" style="@style/MiqatWidgetHeroLatin" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="start|center_vertical" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp"/>
<TextView android:id="@+id/widget_next_time" style="@style/MiqatWidgetHeroLatin" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="40dp" android:gravity="end|center_vertical" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="32sp" android:autoSizeStepGranularity="1sp"/>
</LinearLayout>
</FrameLayout>

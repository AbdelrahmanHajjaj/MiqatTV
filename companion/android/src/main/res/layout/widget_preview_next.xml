<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="locale" android:padding="12dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" style="@style/MiqatWidgetMuted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_preview_metadata" android:maxLines="1" android:layout_alignParentTop="true" />
    <TextView android:id="@+id/widget_next_remaining" style="@style/MiqatWidgetMuted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_preview_remaining" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_alignParentBottom="true" android:layout_margin="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:layout_above="@id/widget_next_remaining" android:layout_below="@id/widget_title" android:padding="8dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:src="@drawable/companion_icon_fajr" android:tint="@color/companion_gold_400" android:importantForAccessibility="no" android:contentDescription="@null" />
        <TextView android:id="@+id/widget_next_label" style="@style/MiqatWidgetHero" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="start|center_vertical" android:includeFontPadding="false" android:text="@string/widget_preview_prayer_0" android:maxLines="1" android:textColor="@color/companion_gold_400" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="38sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/widget_next_time" style="@style/MiqatWidgetHero" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:gravity="end|center_vertical" android:includeFontPadding="false" android:text="@string/widget_preview_time_0" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="44sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
</RelativeLayout>

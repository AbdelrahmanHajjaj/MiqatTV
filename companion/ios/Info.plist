<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Miqat</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array><string>miqat</string></array>
        </dict>
    </array>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Your location calculates local prayer times and the Qibla direction.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>When you turn on Automatic location, Miqat updates prayer times after travel while the app is closed.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Find TVs for setup and connect to paired Miqat TVs on your home network.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_adb._tcp</string>
        <string>_adb-tls-connect._tcp</string>
        <string>_adb-tls-pairing._tcp</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>10.0.0.0/8</key>
            <dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
            <key>172.16.0.0/12</key>
            <dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
            <key>192.168.0.0/16</key>
            <dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
        </dict>
    </dict>
    <key>NSCameraUsageDescription</key>
    <string>Scan the QR code shown on your TV to pair it with Miqat.</string>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>tv.miqat.ios.prayer-refresh</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>fetch</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>

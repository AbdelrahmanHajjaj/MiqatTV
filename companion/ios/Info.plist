    <string>When you turn on Automatic location, Miqat updates prayer times after travel while the app is closed.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Connect to paired Miqat TVs on your home network.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
